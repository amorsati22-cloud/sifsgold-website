# Web3Forms (public keys for browser forms)
NEXT_PUBLIC_WEB3FORMS_WAITLIST_KEY=
NEXT_PUBLIC_WEB3FORMS_ADVOCATE_KEY=

# Resend — add RESEND_API_KEY after domain verification
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=hello@sifsgold.com
RESEND_REPLY_TO=hello@sifsgold.com
RESEND_NOTIFICATIONS_FROM=notifications@sifsgold.com

# Email API auth (server-only unless noted)
EMAIL_SEND_SECRET=
# Shared token for post-form client triggers (set same value for both)
EMAIL_TRIGGER_TOKEN=
NEXT_PUBLIC_EMAIL_TRIGGER_TOKEN=
WEB3FORMS_WEBHOOK_SECRET=

# Optional: Vercel KV for email preference storage (falls back to data/email-preferences.json)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Site URL for email links
NEXT_PUBLIC_SITE_URL=https://sifsgold.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (PCI — card data stays on Stripe Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# EasyPost shipping rates & return labels
EASYPOST_API_KEY=

# Brand Deal Marketplace admin dispute resolution (comma-separated user UUIDs)
ADMIN_USER_IDS=

# Vercel Cron — scheduled Pass-a-Note messages (Bearer token for /api/messages/scheduled/process)
CRON_SECRET=

# Daily.co video calls
DAILY_API_KEY=your_daily_co_api_key
NEXT_PUBLIC_DAILY_DOMAIN=sifsgold.daily.co
DAILY_WEBHOOK_SECRET=
