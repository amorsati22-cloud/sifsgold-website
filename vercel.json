{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/messages/scheduled/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/video-calls/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/video-calls/cron/expire-recordings",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/loyalty/expire-inactive",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/loyalty/birthday-bonus",
      "schedule": "0 8 * * *"
    }
  ]
}
